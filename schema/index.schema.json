{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/celerp/community-modules/main/schema/index.schema.json",
  "title": "Celerp module catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "modules"],
  "properties": {
    "schema_version": { "const": 1 },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "tier", "author", "license"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Module id. Equals the module folder name and the manifest name, unique forever."
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "tier": { "enum": ["community", "verified", "official"] },
        "repo": {
          "type": "string",
          "pattern": "^https://",
          "description": "Public repository with readable source. Required for community and verified tiers."
        },
        "homepage": { "type": "string", "pattern": "^https://" },
        "author": { "type": "string", "minLength": 1, "maxLength": 80 },
        "license": { "type": "string", "minLength": 1, "maxLength": 60 },
        "version": {
          "type": "string",
          "maxLength": 30,
          "description": "The release Celerp distributes. Official and verified tiers only; a community module's version is the one in its own manifest."
        },
        "min_celerp_version": { "type": "string", "maxLength": 30 },
        "data_access": {
          "type": "string",
          "maxLength": 500,
          "description": "What data the module touches. Required for community and verified tiers: an author self-declaration for community, cross-checked against the manifest for verified."
        },
        "network_calls": {
          "type": "string",
          "maxLength": 500,
          "description": "Any network calls the module makes. Same declaration rules as data_access."
        },
        "tags": {
          "type": "array",
          "maxItems": 6,
          "items": { "type": "string", "maxLength": 24 }
        },
        "feedback": {
          "type": "string",
          "pattern": "^https://",
          "description": "Where to share experiences: the module's Discussion in this repo."
        },
        "verified_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "The exact commit reviewed for the verified tier."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the vault snapshot built from verified_commit."
        },
        "price_monthly": { "type": ["number", "null"], "minimum": 0 },
        "price_once": { "type": ["number", "null"], "minimum": 0 }
      }
    }
  }
}
